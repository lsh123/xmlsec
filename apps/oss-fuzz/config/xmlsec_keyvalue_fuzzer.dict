"http://www.w3.org/2009/xmldsig11#"
"http://www.aleksey.com/xmlsec/2002"
"http://www.w3.org/2001/04/xmlenc#"
"KeyInfo"
"KeyValue"
"RSAKeyValue"
"DSAKeyValue"
"ECKeyValue"
"DHKeyValue"
"AESKeyValue"
"HMACKeyValue"
"DESKeyValue"
