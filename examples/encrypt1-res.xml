    <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
	<KeyName>aeskey.bin</KeyName>
    </KeyInfo>
    <CipherData>
	<CipherValue>9RhpPprfCbWVg6tsfmCsSY+Z+Kw8WYPyNJ3hb1omgX4=</CipherValue>
    </CipherData>
</EncryptedData>
