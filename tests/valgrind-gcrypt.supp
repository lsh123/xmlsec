##----------------------------------------------------------------------##
#
# Errors to suppress by default with GCrypt
#
# Format of this file is:
# {
#     name_of_suppression
#     kind: one of Param Value1 Value2 Value4 Value8
#                   Free Addr1 Addr2 Addr4 Addr8
#                   Cond (previously known as Value0)
#     (if Param: name of system call param, if Free: name of free-ing fn)
#     caller0 name, or /name/of/so/file.so
#     caller1 name, or ditto
#     (optionally: caller2 name)
#     (optionally: caller3 name)
#  }

##----------------------------------------------------------------------##
#
# libgcrypt keeps per-process working state (random generator pools,
# MPI/PK working buffers) in process-global variables until exit. The
# state is allocated lazily on first use (version check, key
# generation, signing, verification) and is not released by any public
# API, so it shows up as a "still reachable" residual at the end of
# every xmlsec1 invocation that exercises the corresponding path.
#
# Entries match on exported libgcrypt symbols wherever possible, so they
# work on both stripped and unstripped distribution builds. Where the
# allocation stack carries no exported libgcrypt symbol (gcry_randomize()
# transfers control into non-exported code; see below), the entry is
# anchored on the xmlsec1 caller frame instead.
#
{
   gcry_check_version -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:gcry_check_version
   ...
   fun:main
}

{
   gcry_pk_genkey -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:gcry_pk_genkey
   ...
   fun:main
}

{
   gcry_pk_sign -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:gcry_pk_sign
   ...
   fun:main
}

{
   gcry_pk_verify -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:gcry_pk_verify
   ...
   fun:main
}

#
# The 2 x 664 B RNG working buffers are allocated inside libgcrypt on the
# first strong random request. In libgcrypt >= 1.10 gcry_randomize()
# transfers control directly (without a call) to internal, non-exported
# functions once the RNG state is already initialized, as it is after
# gcry_check_version(), so the allocation stack carries no exported
# libgcrypt symbol and an entry ending in gcry_randomize can never match.
# The allocation is therefore anchored on the xmlsec1 caller instead.
# Without this entry the buffers show up as a "still reachable" residual
# (1,328 bytes in 2 blocks) in every run whose first strong random request
# goes through symmetric key or key data generation.
#
{
   gcry_randomize -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:xmlSecGCryptGenerateRandom
   ...
   fun:main
}

#
# The same 2 x 664 B RNG working buffers are allocated when the first
# strong random request in the process goes through RSA key transport
# decryption: gcry_pk_decrypt() generates strong random for RSA blinding.
# Unlike the gcry_randomize() paths above, the gcry_pk_decrypt() frame is
# an exported symbol and appears in the allocation stack, so this entry
# anchors on it directly.
#
# Note: this entry, unlike the entries above, is not terminated by
# fun:main. On deep call chains (e.g. key loading through
# RetrievalMethod) the allocation stack exceeds the --num-callers limit
# of the test harness and is truncated before main, so a fun:main anchor
# would fail to match. The anchor function itself is specific enough:
# the only allocation that stays reachable under it is libgcrypt's own
# per-process working state.
#
{
   gcry_pk_decrypt -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:gcry_pk_decrypt
}

#
# The same buffers are also allocated when the first strong random request
# in the process is the random IV generated by
# xmlSecGCryptBlockCipherCtxInit() (src/gcrypt/ciphers.c), which calls
# gcry_randomize() directly. The gcry_randomize() frame does not appear in
# the allocation stack for the same reason as in the
# xmlSecGCryptGenerateRandom entry above, so this entry is anchored on the
# xmlsec1 caller frame instead. As with the entry above, it is not
# terminated by fun:main (see the note there).
#
{
   xmlSecGCryptBlockCipherCtxInit -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:xmlSecGCryptBlockCipherCtxInit
}
