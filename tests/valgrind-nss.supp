##----------------------------------------------------------------------##
#
# Errors to suppress by default with NSS
#
# Format of this file is:
# {
#     name_of_suppression
#     kind: one of Param Value1 Value2 Value4 Value8
#                   Free Addr1 Addr2 Addr4 Addr8
#                   Cond (previously known as Value0)
#     (if Param: name of system call param, if Free: name of free-ing fn)
#     caller0 name, or /name/of/so/file.so
#     caller1 name, or ditto
#     (optionally: caller2 name)
#     (optionally: caller3 name)
#  }

##----------------------------------------------------------------------##
#
# NSS keeps one-time initialisation state (crypto module setup,
# PKCS#11 token configuration) in process-global variables until exit.
# The allocations are made during NSS_InitReadWrite /
# PK11_ConfigurePKCS11 and are not released by any public API, so they
# show up as a "still reachable" residual in every xmlsec1 invocation.
#
{
   NSS_InitReadWrite -> malloc (reachable)
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:NSS_InitReadWrite
   ...
   fun:main
}

{
   NSS_InitReadWrite -> calloc (reachable)
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   ...
   fun:NSS_InitReadWrite
   ...
   fun:main
}

{
   PK11_ConfigurePKCS11 -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:PK11_ConfigurePKCS11
   ...
   fun:main
}

{
   PK11_ConfigurePKCS11 -> realloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:realloc
   ...
   fun:PK11_ConfigurePKCS11
   ...
   fun:main
}
