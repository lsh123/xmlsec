##----------------------------------------------------------------------##
#
# Errors to suppress by default with OpenSSL
#
# Format of this file is:
# {
#     name_of_suppression
#     kind: one of Param Value1 Value2 Value4 Value8
#                   Free Addr1 Addr2 Addr4 Addr8
#                   Cond (previously known as Value0)
#     (if Param: name of system call param, if Free: name of free-ing fn)
#     caller0 name, or /name/of/so/file.so
#     caller1 name, or ditto
#     (optionally: caller2 name)
#     (optionally: caller3 name)
#  }

##----------------------------------------------------------------------##
#
# OpenSSL keeps one-time initialisation state (provider loading,
# algorithm dispatch) in process-global variables until exit. The
# allocations are made during OPENSSL_init_crypto on the first use of
# the library and are not released by any public API, so they show up
# as a small "still reachable" residual in every xmlsec1 invocation.
#
{
   OPENSSL_init_crypto -> malloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   ...
   fun:OPENSSL_init_crypto
   ...
   fun:main
}

{
   OPENSSL_init_crypto -> calloc
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   ...
   fun:OPENSSL_init_crypto
   ...
   fun:main
}
