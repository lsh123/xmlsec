prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: xmlsec1-nss
Version: @VERSION@
Description: XML Security Library implements XML Signature and XML Encryption standards
Requires: @NSS_PACKAGE@ >= @NSS_MIN_VERSION@, @NSPR_PACKAGE@ >= @NSPR_MIN_VERSION@, libxml-2.0 >= @LIBXML_MIN_VERSION@ @LIBXSLT_PC_FILE_COND@
Cflags: @XMLSEC_NSS_CFLAGS@
Cflags.private: -DXMLSEC_STATIC
Libs: @XMLSEC_NSS_LIBS@
