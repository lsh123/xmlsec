Summary: Library providing support for "XML Signature" and "XML Encryption" standards
Name: @PACKAGE@
Version: @VERSION@
Release: 1
License: MIT
Vendor: Aleksey Sanin <aleksey@aleksey.com>
Packager: Aleksey Sanin <aleksey@aleksey.com>
Source: https://www.aleksey.com/xmlsec/releases/@PACKAGE@-%{version}.tar.gz
URL: http://www.aleksey.com/xmlsec

# The values below are substituted by configure: 1 means the feature/library
# was not configured or not found, 0 means it is built into this package.
# Keep them in sync with the %if checks in the sections below.
%define no_libxslt @XMLSEC_NO_LIBXSLT@
%define no_openssl @XMLSEC_NO_OPENSSL@
%define no_nss @XMLSEC_NO_NSS@
%define no_gnutls @XMLSEC_NO_GNUTLS@
%define no_gcrypt @XMLSEC_NO_GCRYPT@

Requires: libxml2 >= @LIBXML_MIN_VERSION@
%if %{no_libxslt} == 0
Requires: libxslt >= @LIBXSLT_MIN_VERSION@
%endif
%if %{no_openssl} == 0
Requires: xmlsec1-openssl = %{version}
%endif
BuildRequires: gcc
BuildRequires: make
BuildRequires: autoconf
BuildRequires: automake
BuildRequires: libtool
BuildRequires: help2man
BuildRequires: libxml2-devel >= @LIBXML_MIN_VERSION@
%if %{no_libxslt} == 0
BuildRequires: libxslt-devel >= @LIBXSLT_MIN_VERSION@
%endif
%if %{no_openssl} == 0
BuildRequires: openssl-devel >= @OPENSSL_MIN_VERSION@
%endif
%if %{no_nss} == 0
BuildRequires: nss-devel >= @NSS_MIN_VERSION@
BuildRequires: nspr-devel >= @NSPR_MIN_VERSION@
%endif
%if %{no_gnutls} == 0
BuildRequires: gnutls-devel >= @GNUTLS_MIN_VERSION@
%endif
%if %{no_gcrypt} == 0
BuildRequires: libgcrypt-devel >= @GCRYPT_MIN_VERSION@
%endif

%define _missing_doc_files_terminate_build 0

%description
XML Security Library is a C library based on LibXML2 with pluggable crypto backends.
The library was created with a goal to support major XML security
standards "XML Digital Signature" and "XML Encryption".

%package devel
Summary: Libraries, includes, etc. to develop applications with XML Digital Signatures and XML Encryption support.
Requires: xmlsec1 = %{version}
Requires: libxml2-devel >= @LIBXML_MIN_VERSION@
%if %{no_libxslt} == 0
Requires: libxslt-devel >= @LIBXSLT_MIN_VERSION@
%endif
%if %{no_openssl} == 0
Requires: openssl-devel >= @OPENSSL_MIN_VERSION@
%endif

%description devel
Libraries, includes, etc. you can use to develop applications with XML Digital
Signatures and XML Encryption support.

%if %{no_openssl} == 0
%package openssl
Summary: OpenSSL crypto plugin for XML Security Library
Requires: xmlsec1 = %{version}
Requires: libxml2 >= @LIBXML_MIN_VERSION@
Requires: libxslt >= @LIBXSLT_MIN_VERSION@
Requires: openssl >= @OPENSSL_MIN_VERSION@

%post -n %{name}-openssl
/sbin/ldconfig

%postun -n %{name}-openssl
/sbin/ldconfig

%description openssl
OpenSSL plugin for XML Security Library provides OpenSSL based crypto services
for the xmlsec library.

%package openssl-devel
Summary: OpenSSL crypto plugin for XML Security Library
Requires: xmlsec1 = %{version}
Requires: xmlsec1-devel = %{version}
Requires: xmlsec1-openssl = %{version}
Requires: libxml2-devel >= @LIBXML_MIN_VERSION@
Requires: libxslt-devel >= @LIBXSLT_MIN_VERSION@
Requires: openssl >= @OPENSSL_MIN_VERSION@
Requires: openssl-devel >= @OPENSSL_MIN_VERSION@

%description openssl-devel
Libraries, includes, etc. for developing XML Security applications with OpenSSL.
%endif

%if %{no_nss} == 0
%package nss
Summary: NSS crypto plugin for XML Security Library
Requires: xmlsec1 = %{version}
Requires: libxml2 >= @LIBXML_MIN_VERSION@
Requires: libxslt >= @LIBXSLT_MIN_VERSION@
Requires: nss >= @NSS_MIN_VERSION@
Requires: nspr >= @NSPR_MIN_VERSION@

%post -n %{name}-nss
/sbin/ldconfig

%postun -n %{name}-nss
/sbin/ldconfig

%description nss
NSS plugin for XML Security Library provides NSS based crypto services
for the xmlsec library.

%package nss-devel
Summary: NSS crypto plugin for XML Security Library
Requires: xmlsec1 = %{version}
Requires: xmlsec1-devel = %{version}
Requires: xmlsec1-nss = %{version}
Requires: libxml2-devel >= @LIBXML_MIN_VERSION@
Requires: libxslt-devel >= @LIBXSLT_MIN_VERSION@
Requires: nss-devel >= @NSS_MIN_VERSION@
Requires: nspr-devel >= @NSPR_MIN_VERSION@

%description nss-devel
Libraries, includes, etc. for developing XML Security applications with NSS.
%endif

%if %{no_gnutls} == 0
%package gnutls
Summary: GnuTLS crypto plugin for XML Security Library
Requires: xmlsec1 = %{version}
Requires: libxml2 >= @LIBXML_MIN_VERSION@
Requires: libxslt >= @LIBXSLT_MIN_VERSION@
Requires: gnutls >= @GNUTLS_MIN_VERSION@

%post -n %{name}-gnutls
/sbin/ldconfig

%postun -n %{name}-gnutls
/sbin/ldconfig

%description gnutls
GnuTLS plugin for XML Security Library provides GnuTLS based crypto services
for the xmlsec library.

%package gnutls-devel
Summary: GnuTLS crypto plugin for XML Security Library
Requires: xmlsec1 = %{version}
Requires: xmlsec1-devel = %{version}
Requires: xmlsec1-gnutls = %{version}
Requires: libxml2-devel >= @LIBXML_MIN_VERSION@
Requires: libxslt-devel >= @LIBXSLT_MIN_VERSION@
Requires: gnutls-devel >= @GNUTLS_MIN_VERSION@

%description gnutls-devel
Libraries, includes, etc. for developing XML Security applications with GnuTLS.
%endif

%if %{no_gcrypt} == 0
%package gcrypt
Summary: GCrypt crypto plugin for XML Security Library
Requires: xmlsec1 = %{version}
Requires: libxml2 >= @LIBXML_MIN_VERSION@
Requires: libxslt >= @LIBXSLT_MIN_VERSION@
Requires: libgcrypt >= @GCRYPT_MIN_VERSION@

%post -n %{name}-gcrypt
/sbin/ldconfig

%postun -n %{name}-gcrypt
/sbin/ldconfig

%description gcrypt
GCrypt plugin for XML Security Library provides GCrypt based crypto services
for the xmlsec library.

%package gcrypt-devel
Summary: GCrypt crypto plugin for XML Security Library
Requires: xmlsec1 = %{version}
Requires: xmlsec1-devel = %{version}
Requires: xmlsec1-gcrypt = %{version}
Requires: libxml2-devel >= @LIBXML_MIN_VERSION@
Requires: libxslt-devel >= @LIBXSLT_MIN_VERSION@
Requires: libgcrypt-devel >= @GCRYPT_MIN_VERSION@

%description gcrypt-devel
Libraries, includes, etc. for developing XML Security applications with GCrypt.
%endif

%prep
%setup -q

%build
# Needed for snapshot releases.
if [ ! -f configure ]; then
  CFLAGS="$RPM_OPT_FLAGS" ./autogen.sh --prefix=%{_prefix} --sysconfdir="/etc" --mandir=%{_mandir} --libdir=%{_libdir}
else
  CFLAGS="$RPM_OPT_FLAGS" ./configure --prefix=%{_prefix} --sysconfdir="/etc" --mandir=%{_mandir} --libdir=%{_libdir}
fi
%make_build

%install
rm -rf $RPM_BUILD_ROOT
mkdir -p $RPM_BUILD_ROOT%{_bindir}
mkdir -p $RPM_BUILD_ROOT%{_includedir}/@PACKAGE@
mkdir -p $RPM_BUILD_ROOT%{_libdir}
mkdir -p $RPM_BUILD_ROOT%{_mandir}/man1
make -C man docs
make prefix=$RPM_BUILD_ROOT%{_prefix} mandir=$RPM_BUILD_ROOT%{_mandir} libdir=$RPM_BUILD_ROOT%{_libdir} install

%clean
rm -rf $RPM_BUILD_ROOT

%post /sbin/ldconfig

%postun /sbin/ldconfig

%files
%defattr(-, root, root)

%doc AUTHORS.md ChangeLog NEWS README.md Copyright
%doc %{_mandir}/man1/xmlsec1.1*

%{_libdir}/libxmlsec1.so.*
%{_bindir}/xmlsec1

%files devel
%defattr(-, root, root)

%{_bindir}/xmlsec1-config
%{_includedir}/xmlsec1/xmlsec/*.h
%{_libdir}/libxmlsec1.so
%{_libdir}/libxmlsec1.*a
%{_libdir}/pkgconfig/xmlsec1.pc
%{_libdir}/xmlsec1Conf.sh
%{_datadir}/doc/xmlsec1/*
%{_datadir}/aclocal/xmlsec1.m4
%doc AUTHORS.md HACKING ChangeLog NEWS README.md Copyright
%doc %{_mandir}/man1/xmlsec1-config.1*

%if %{no_openssl} == 0
%files openssl
%defattr(-, root, root)

%{_libdir}/libxmlsec1-openssl.so.*

%files openssl-devel
%defattr(-, root, root)

%{_includedir}/xmlsec1/xmlsec/openssl/*.h
%{_libdir}/libxmlsec1-openssl.so
%{_libdir}/libxmlsec1-openssl.*a
%{_libdir}/pkgconfig/xmlsec1-openssl.pc
%endif

%if %{no_nss} == 0
%files nss
%defattr(-, root, root)

%{_libdir}/libxmlsec1-nss.so.*

%files nss-devel
%defattr(-, root, root)

%{_includedir}/xmlsec1/xmlsec/nss/*.h
%{_libdir}/libxmlsec1-nss.so
%{_libdir}/libxmlsec1-nss.*a
%{_libdir}/pkgconfig/xmlsec1-nss.pc
%endif

%if %{no_gnutls} == 0
%files gnutls
%defattr(-, root, root)

%{_libdir}/libxmlsec1-gnutls.so.*

%files gnutls-devel
%defattr(-, root, root)

%{_includedir}/xmlsec1/xmlsec/gnutls/*.h
%{_libdir}/libxmlsec1-gnutls.so
%{_libdir}/libxmlsec1-gnutls.*a
%{_libdir}/pkgconfig/xmlsec1-gnutls.pc
%endif

%if %{no_gcrypt} == 0
%files gcrypt
%defattr(-, root, root)

%{_libdir}/libxmlsec1-gcrypt.so.*

%files gcrypt-devel
%defattr(-, root, root)

%{_includedir}/xmlsec1/xmlsec/gcrypt/*.h
%{_libdir}/libxmlsec1-gcrypt.so
%{_libdir}/libxmlsec1-gcrypt.*a
%{_libdir}/pkgconfig/xmlsec1-gcrypt.pc
%endif

%changelog
