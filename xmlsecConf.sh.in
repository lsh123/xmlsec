#!/bin/sh
#
# Configuration file for the XML Security Library (xmlsec)
#
prefix="@prefix@"
exec_prefix="@exec_prefix@"
libdir="@libdir@"
includedir="@includedir@"

XMLSEC_LIBDIR="@XMLSEC_LIBDIR@"
